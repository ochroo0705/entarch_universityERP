APP_STORAGE_SECRET_KEY=replace-me
APP_STORAGE_ENDPOINT=
APP_STORAGE_PATH_STYLE=false
APP_STORAGE_KEY_PREFIX=

APP_BOOTSTRAP_ENABLED=false
