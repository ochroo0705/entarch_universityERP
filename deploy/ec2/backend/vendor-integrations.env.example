# University ERP vendor integration onboarding values.
# Copy real values into the EC2 `.env` file or your secret manager. Do not commit real secrets.

UNIVERSITY_ERP_LMS_ENDPOINT=https://lms-vendor.example.edu/api/roster/import
UNIVERSITY_ERP_LMS_AUTH_TYPE=BEARER_TOKEN
UNIVERSITY_ERP_LMS_SECRET_REF=env:UNIVERSITY_ERP_LMS_TOKEN
UNIVERSITY_ERP_LMS_TOKEN=replace-with-real-lms-token

UNIVERSITY_ERP_BANK_ENDPOINT=https://bank-vendor.example.com/api/payments/callback
UNIVERSITY_ERP_BANK_AUTH_TYPE=API_KEY
UNIVERSITY_ERP_BANK_SECRET_REF=env:UNIVERSITY_ERP_BANK_API_KEY
UNIVERSITY_ERP_BANK_API_KEY=replace-with-real-bank-api-key

UNIVERSITY_ERP_NOTIFICATION_ENDPOINT=https://notification-vendor.example.com/api/messages
UNIVERSITY_ERP_NOTIFICATION_AUTH_TYPE=API_KEY
UNIVERSITY_ERP_NOTIFICATION_SECRET_REF=env:UNIVERSITY_ERP_NOTIFICATION_API_KEY
UNIVERSITY_ERP_NOTIFICATION_API_KEY=replace-with-real-notification-api-key

UNIVERSITY_ERP_GOVERNMENT_ENDPOINT=https://government-vendor.example.gov/api/statutory-reports
UNIVERSITY_ERP_GOVERNMENT_AUTH_TYPE=BEARER_TOKEN
UNIVERSITY_ERP_GOVERNMENT_SECRET_REF=env:UNIVERSITY_ERP_GOVERNMENT_TOKEN
UNIVERSITY_ERP_GOVERNMENT_TOKEN=replace-with-real-government-token
